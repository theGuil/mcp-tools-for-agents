# Diretório onde o agente lê e grava arquivos. Nada fora dele é acessível.
WORKSPACE_DIR=./workspace

# Binários externos. Nome no PATH ou caminho absoluto. Se não existirem e
# MCP_AUTO_DOWNLOAD=true, o servidor baixa sozinho para MCP_CACHE_DIR.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp

# Baixa ffmpeg, yt-dlp e modelos do Whisper sob demanda (true/false).
MCP_AUTO_DOWNLOAD=true

# Pasta de cache dos downloads (binários, fontes, modelos). Padrão:
# ~/.cache/mcp-tools-for-agents (Linux), ~/Library/Caches/... (macOS),
# %LOCALAPPDATA%\mcp-tools-for-agents (Windows).
MCP_CACHE_DIR=

# Timeout em segundos para cada chamada síncrona ao ffmpeg.
FFMPEG_TIMEOUT=600

# Threads para jobs em background.
JOB_WORKERS=2

# Domínios de tools ativos, separados por vírgula. Vazio ativa todos.
# Opções: video, audio, files, jobs, media
MCP_DOMAINS=video,audio,files,jobs,media

# Timeout em segundos para download de vídeo da internet (qualquer site).
DOWNLOAD_TIMEOUT=900

# Chave da API do Freesound, usada por search_sound_effects, download_sound_effect
# e add_sound_effects. O projeto já traz uma chave embutida em config.rs; defina
# aqui só para usar outra. Crie a sua grátis em https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=
