# Diretório onde o agente lê e grava arquivos. Nada fora dele é acessível.
WORKSPACE_DIR=./workspace

# Binários do FFmpeg. Use caminho absoluto se não estiverem no PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Timeout em segundos para cada chamada síncrona ao ffmpeg.
FFMPEG_TIMEOUT=600

# Threads para jobs em background.
JOB_WORKERS=2

# Domínios de tools ativos, separados por vírgula. Vazio ativa todos.
# Opções: video, audio, files, jobs, youtube
MCP_DOMAINS=video,audio,files,jobs,youtube

# Timeout em segundos para download de vídeo do YouTube.
YOUTUBE_TIMEOUT=900
