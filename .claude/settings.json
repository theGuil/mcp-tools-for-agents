{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__mcp-tools-for-agents",
      "mcp__mcp-tools-for-agents__*",
      "mcp__mcp-tools-for-agents__add_background_music",
      "mcp__mcp-tools-for-agents__add_banner",
      "mcp__mcp-tools-for-agents__add_fade",
      "mcp__mcp-tools-for-agents__add_narration",
      "mcp__mcp-tools-for-agents__add_sound_effects",
      "mcp__mcp-tools-for-agents__add_text_overlay",
      "mcp__mcp-tools-for-agents__apply_studio_background_light",
      "mcp__mcp-tools-for-agents__apply_template",
      "mcp__mcp-tools-for-agents__burn_subtitles",
      "mcp__mcp-tools-for-agents__change_speed",
      "mcp__mcp-tools-for-agents__concat_videos",
      "mcp__mcp-tools-for-agents__create_dynamic_subtitles",
      "mcp__mcp-tools-for-agents__create_subtitles",
      "mcp__mcp-tools-for-agents__create_thumbnail",
      "mcp__mcp-tools-for-agents__cut_video",
      "mcp__mcp-tools-for-agents__delete_file",
      "mcp__mcp-tools-for-agents__detect_scenes",
      "mcp__mcp-tools-for-agents__download_sound_effect",
      "mcp__mcp-tools-for-agents__download_video",
      "mcp__mcp-tools-for-agents__export_for_platform",
      "mcp__mcp-tools-for-agents__extract_audio",
      "mcp__mcp-tools-for-agents__extract_frame",
      "mcp__mcp-tools-for-agents__get_video_info",
      "mcp__mcp-tools-for-agents__job_result",
      "mcp__mcp-tools-for-agents__job_status",
      "mcp__mcp-tools-for-agents__list_files",
      "mcp__mcp-tools-for-agents__list_templates",
      "mcp__mcp-tools-for-agents__normalize_audio",
      "mcp__mcp-tools-for-agents__probe_video",
      "mcp__mcp-tools-for-agents__remove_silence",
      "mcp__mcp-tools-for-agents__search_sound_effects",
      "mcp__mcp-tools-for-agents__set_video_metadata",
      "mcp__mcp-tools-for-agents__smart_crop",
      "mcp__mcp-tools-for-agents__transcribe_audio",
      "mcp__mcp-tools-for-agents__zoom_video",
      "mcp__mcp-tools-for-agents__stabilize_video",
      "mcp__Zernio",
      "mcp__Zernio__*",
      "Bash",
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "TodoWrite",
      "SlashCommand",
      "Skill"
    ],
    "additionalDirectories": [
      "/tmp",
      "/root/.cache/mcp-tools-for-agents"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "mcp-tools-for-agents"
  ],
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/scripts/install-mcp-tools.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
